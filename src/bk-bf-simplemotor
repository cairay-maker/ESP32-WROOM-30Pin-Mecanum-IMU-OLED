#include <Arduino.h>
#include <WiFi.h>
#include <esp_wifi.h>
#include <Wire.h>

#include "hal/ServoHandler.h"
#include "hal/ESPNowHandler.h"
#include "hal/MotorDrive.h"

ServoHandler legServos;
ESPNowHandler radio;
MotorDrive motors;

// Tracking for remote input deadbands
float lastHeightOffset = -999.0f;
float lastSplitOffset  = -999.0f;

void setup() {
    Serial.begin(115200);
    delay(1000);

    Serial.println("\n=== Quadruped System Initializing ===");

    // 1. WiFi & ESP-NOW Channel Lock
    WiFi.mode(WIFI_STA);
    esp_wifi_set_promiscuous(true);
    esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
    esp_wifi_set_promiscuous(false);

    // 2. Shared I2C Bus for PCA9685 Servos (SDA: 21, SCL: 22)
    Wire.begin(21, 22);
    Wire.setClock(100000);

    // 3. Initialize Hardware Modules
    legServos.begin();
    legServos.setNeutralPose();
    radio.begin();
    motors.init();

    Serial.println(">>> System Ready.");

    // --- MOTOR TEST DIRECTION ROUTINE ---
    // Runs all four motors at a slow PWM speed (100) for 5 seconds
    Serial.println("\n-------------------------------------------");
    Serial.println(">>> STARTING MOTOR DIRECTION TEST (SPEED = 100)");
    Serial.println(">>> Observe each wheel and note if it moves FORWARD or BACKWARD.");
    Serial.println("-------------------------------------------\n");

    motors.drive(100, 100, 100, 100); // Drive FL, FR, RL, RR at speed 100
    delay(10000);                      // Run for 5 seconds
    motors.stop();

    Serial.println(">>> TEST COMPLETE: Motors Stopped.");
    Serial.println(">>> Please report which wheels moved Forward and which moved Backward.");
}

void loop() {
    // 1. Non-blocking interleaved leg updates
    legServos.update();

    // 2. Process USB Serial commands (keyboard overrides)
    legServos.processSerialCommands();

    // 3. Process Wireless ESP-NOW Remote Commands
    if (radio.isConnected()) {
        const PacketData& remote = radio.getLatestPacket();

        float rawPL = remote.pL;
        float rawPM = remote.pM;

        // Snap-to-Neutral around 0.0 to prevent jitter
        if (abs(rawPL) < 0.04f) rawPL = 0.0f;
        if (abs(rawPM) < 0.04f) rawPM = 0.0f;

        // 2 degrees per 0.1 step multiplier (x20)
        float targetHeightOffset = round(rawPL * 20.0f);
        float targetSplitOffset  = round(rawPM * 20.0f);

        if (targetHeightOffset != lastHeightOffset || targetSplitOffset != lastSplitOffset) {
            lastHeightOffset = targetHeightOffset;
            lastSplitOffset  = targetSplitOffset;

            legServos.applyPoseOffsets(targetHeightOffset, targetSplitOffset);

            Serial.printf(">>> REMOTE INPUT: Height = %+.0f deg | Split = %+.0f deg\n", 
                          targetHeightOffset, targetSplitOffset);
        }
    }
}